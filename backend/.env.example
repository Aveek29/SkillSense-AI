# SkillSense AI — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Required: Groq API key for LLM features
GROQ_API_KEY=

# Optional: Google Gemini API key (fallback LLM)
GEMINI_API_KEY=

# Security: Set strong random keys for JWT and AES
JWT_SECRET_KEY=
AES_SECRET_KEY_B64=

# Database (default: SQLite for local dev)
DATABASE_URL=sqlite:///./database/skillsense_dev.db

# AWS Credentials (optional, for cloud sandbox provisioning)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Application
DEBUG=False
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
